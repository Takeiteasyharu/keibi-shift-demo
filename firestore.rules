rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{workerId}: profile PII (including optional furigana). Web users use workerId == Auth UID;
    // managed users use an auto ID, inputMode == managed, authUid == null.
    // userRoles/{workerId}: role, branchId, accountStatus, leaderEligible, timestamps
    // employeeNumbers/{6 digits}: uid
    // availability/{date_uid}: owner availability with branchId
    // staffRequests/{uid}: one staff application per user
    // shiftGroups/{auto-id}: office-created daily staffing groups
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function rolePath(uid) { return /databases/$(database)/documents/userRoles/$(uid); }
    function myRole() { return get(rolePath(request.auth.uid)).data; }
    function isOperationalStatus(status) { return status in ['active','approved']; }
    function isActive() { return isAuthenticated() && isOperationalStatus(myRole().accountStatus); }
    function isStaff() { return isActive() && myRole().role == 'staff'; }
    function isAdmin() { return isActive() && myRole().role == 'admin'; }
    function isOffice() { return isStaff() || isAdmin(); }
    function validBranchId(value) { return value in ['kokubunji','mitaka']; }
    function isSameBranch(branchId) { return isAdmin() || (isStaff() && myRole().branchId == branchId); }
    function isValidBranch(data, branchId) {
      return validBranchId(branchId)
        && data.keys().hasAll(['name','active','createdAt','updatedAt'])
        && data.keys().hasOnly(['name','active','createdAt','updatedAt'])
        && validText(data.name,1,40) && data.active is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validEmail(value) { return validText(value,3,254) && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$'); }
    function internalEmail(number) { return 'keibi-' + number + '@auth.keibi.invalid'; }
    function isValidUser(data) {
      return data.keys().hasAll(['employeeNumber','name','contactEmail','postalCode','prefecture','city',
        'addressLine','building','nearestStation','createdAt','updatedAt'])
        && data.keys().hasOnly(['employeeNumber','name','furigana','contactEmail','postalCode','prefecture','city',
        'addressLine','building','nearestStation','phone','branchId','requestedBranchId','inputMode','authUid','createdBy',
        'updatedByUid','updatedByName','createdAt','updatedAt'])
        && data.employeeNumber is string && data.employeeNumber.matches('^[0-9]{6}$')
        && validText(data.name,1,80)
        && (!('furigana' in data) || (validText(data.furigana,1,80) && data.furigana.matches('^[ぁ-んァ-ヶー・ 　]+$')))
        && (data.contactEmail == '' || validEmail(data.contactEmail))
        && data.postalCode is string && (data.postalCode == '' || data.postalCode.matches('^[0-9]{7}$'))
        && validText(data.prefecture,0,20) && validText(data.city,0,80)
        && validText(data.addressLine,0,160) && validText(data.building,0,160)
        && validText(data.nearestStation,0,80)
        && (!('branchId' in data) || validBranchId(data.branchId))
        && (!('requestedBranchId' in data) || validBranchId(data.requestedBranchId))
        && (!('phone' in data) || validText(data.phone,0,20))
        && (!('inputMode' in data) || data.inputMode in ['web','managed'])
        && (!('authUid' in data) || data.authUid == null || validText(data.authUid,1,128))
        && (!('createdBy' in data) || validText(data.createdBy,1,128))
        && (!('updatedByUid' in data) || validText(data.updatedByUid,1,128))
        && (!('updatedByName' in data) || validText(data.updatedByName,1,80))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isValidManagedUser(data) {
      return isValidUser(data)
        && data.keys().hasAll(['inputMode','authUid','createdBy'])
        && data.inputMode == 'managed' && data.authUid == null
        && validText(data.nearestStation,1,80)
        && validText(data.createdBy,1,128);
    }
    function isValidRole(data) {
      return data.keys().hasAll(['role','accountStatus','leaderEligible','createdAt','updatedAt'])
        && data.keys().hasOnly(['role','branchId','requestedBranchId','accountStatus','leaderEligible','createdAt','updatedAt',
          'disabledAt','disabledByUid','approvedByUid','approvedAt','rejectedByUid','rejectedAt','rejectionReason'])
        && data.role in ['guard','staff','admin']
        && (!('branchId' in data) || data.branchId == null || validBranchId(data.branchId))
        && (!('requestedBranchId' in data) || validBranchId(data.requestedBranchId))
        && data.accountStatus in ['pending','approved','rejected','active','inactive','suspended','disabled']
        && data.leaderEligible is bool && data.createdAt is timestamp && data.updatedAt is timestamp
        && (
          (data.accountStatus == 'inactive'
            && data.keys().hasAll(['disabledAt','disabledByUid'])
            && data.disabledAt is timestamp && validText(data.disabledByUid,1,128))
          || (data.accountStatus != 'inactive'
            && !('disabledAt' in data) && !('disabledByUid' in data))
        )
        && (data.role != 'admin' || !('branchId' in data) || data.branchId == null)
        && (data.accountStatus != 'pending'
          || (!('branchId' in data) && data.role == 'guard' && validBranchId(data.requestedBranchId)))
        && (data.role == 'admin' || data.accountStatus in ['pending','rejected'] || validBranchId(data.branchId))
        && (!('approvedByUid' in data) || validText(data.approvedByUid,1,128))
        && (!('approvedAt' in data) || data.approvedAt is timestamp)
        && (!('rejectedByUid' in data) || validText(data.rejectedByUid,1,128))
        && (!('rejectedAt' in data) || data.rejectedAt is timestamp)
        && (!('rejectionReason' in data) || validText(data.rejectionReason,1,200));
    }
    function isValidDeactivation(uid) {
      return isOffice() && uid != request.auth.uid
        && isSameBranch(resource.data.branchId)
        && isOperationalStatus(resource.data.accountStatus)
        && resource.data.role in ['guard','staff']
        && request.resource.data.accountStatus == 'inactive'
        && request.resource.data.role == resource.data.role
        && request.resource.data.branchId == resource.data.branchId
        && request.resource.data.disabledAt == request.time
        && request.resource.data.disabledByUid == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accountStatus','disabledAt','disabledByUid','updatedAt']);
    }
    function isValidRestoration(uid) {
      return isAdmin() && uid != request.auth.uid
        && isSameBranch(resource.data.branchId)
        && resource.data.accountStatus == 'inactive'
        && resource.data.role in ['guard','staff']
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.role == resource.data.role
        && request.resource.data.branchId == resource.data.branchId
        && !('disabledAt' in request.resource.data)
        && !('disabledByUid' in request.resource.data)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['accountStatus','disabledAt','disabledByUid','updatedAt']);
    }
    function isInitialGuard(data) {
      return isValidRole(data) && data.role == 'guard' && !('branchId' in data)
        && data.accountStatus == 'pending' && validBranchId(data.requestedBranchId)
        && data.leaderEligible == false
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function isInitialManagedGuard(data) {
      return isValidRole(data) && data.role == 'guard'
        && isSameBranch(data.branchId)
        && data.accountStatus == 'active' && data.leaderEligible == false
        && data.createdAt == request.time && data.updatedAt == request.time;
    }
    function validChoice(data) {
      return (!data.unavailable || (!data.day && !data.night && !data.undecided))
        && (!data.undecided || (!data.day && !data.night && !data.unavailable));
    }
    function isValidAvailability(data,id) {
      return data.keys().hasAll(['uid','branchId','date','day','night','unavailable','undecided','note',
          'updatedByUid','updatedByName','updatedByType','updatedAfterDeadline','createdAt','updatedAt'])
        && data.keys().hasOnly(['uid','branchId','date','day','night','dayEntered','nightEntered','unavailable','undecided','note',
          'updatedByUid','updatedByName','updatedByType','updatedByRole','updateReason','updateReasonNote',
          'updatedAfterDeadline','createdAt','updatedAt'])
        && (isAdmin() || data.branchId == myRole().branchId)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == data.date + '_' + data.uid && data.day is bool && data.night is bool
        && (!('dayEntered' in data) || data.dayEntered is bool)
        && (!('nightEntered' in data) || data.nightEntered is bool)
        && data.unavailable is bool && data.undecided is bool && validChoice(data)
        && validText(data.note,0,500)
        && validText(data.updatedByUid,1,128) && validText(data.updatedByName,1,80)
        && data.updatedByType in ['self','proxy']
        && (!('updatedByRole' in data) || validText(data.updatedByRole,0,10))
        && (!('updateReason' in data) || validText(data.updateReason,0,40))
        && (!('updateReasonNote' in data) || validText(data.updateReasonNote,0,200))
        && data.updatedAfterDeadline is bool
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function isSelfAvailability(data) {
      return data.uid == request.auth.uid
        && data.updatedByUid == request.auth.uid && data.updatedByType == 'self'
        && data.updatedByName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && (!('updatedByRole' in data) || data.updatedByRole == '')
        && (!('updateReason' in data) || data.updateReason == '')
        && (!('updateReasonNote' in data) || data.updateReasonNote == '')
        && data.updatedAfterDeadline == false;
    }
    function hasValidProxyAudit(data) {
      return data.updatedByType == 'proxy'
        && data.updatedByRole == myRole().role
        && data.updatedByRole in ['staff','admin']
        && data.updateReason in ['phone_request','in_person_request','paper_transfer','staff_correction','other']
        && ((data.updateReason == 'other' && validText(data.updateReasonNote,1,200))
          || (data.updateReason != 'other' && data.updateReasonNote == ''));
    }
    function isManagedAvailability(data) {
      return isOffice() && data.uid != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(data.uid))
        && exists(rolePath(data.uid))
        && data.updatedByUid == request.auth.uid
        && data.updatedByName == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name
        && data.branchId == get(rolePath(data.uid)).data.branchId
        && isSameBranch(get(rolePath(data.uid)).data.branchId)
        && isOperationalStatus(get(rolePath(data.uid)).data.accountStatus)
        && hasValidProxyAudit(data)
        && (get(/databases/$(database)/documents/users/$(data.uid)).data.inputMode in ['managed','web']
          || !('inputMode' in get(/databases/$(database)/documents/users/$(data.uid)).data))
        && (isAdmin() || get(rolePath(data.uid)).data.role != 'admin');
    }
    function isValidRequest(data,uid) {
      return data.keys().hasAll(['uid','employeeNumber','name','branchId','status','createdAt','updatedAt'])
        && data.keys().hasOnly(['uid','employeeNumber','name','branchId','status','createdAt','updatedAt','reviewedBy','reviewedAt'])
        && data.uid == uid && data.employeeNumber is string && data.employeeNumber.matches('^[0-9]{6}$')
        && validText(data.name,1,80) && validText(data.branchId,1,40)
        && data.status in ['pending','approved','rejected']
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && (!('reviewedBy' in data) || validText(data.reviewedBy,1,128))
        && (!('reviewedAt' in data) || data.reviewedAt is timestamp);
    }
    function isValidShiftGroup(data) {
      return data.keys().hasAll(['date','shiftType','branchId','title','clientName','address','meetingPlace',
        'meetingTime','startTime','endTime','leaderUid','memberUids','requiredMembers','status','createdBy',
        'updatedByUid','updatedByName','createdAt','updatedAt'])
      && data.keys().hasOnly(['date','shiftType','branchId','title','clientName','address','meetingPlace',
        'meetingTime','startTime','endTime','departureCheckTime','note','leaderUid','memberUids','requiredMembers',
        'status','createdBy','createdByName','updatedByUid','updatedByName','createdAt','updatedAt'])
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shiftType in ['day','night'] && validText(data.branchId,1,40)
        && validText(data.title,0,80) && validText(data.clientName,0,80)
        && validText(data.address,0,150) && validText(data.meetingPlace,0,100)
        && data.meetingTime is string && (data.meetingTime == '' || data.meetingTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && data.startTime is string && (data.startTime == '' || data.startTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && data.endTime is string && (data.endTime == '' || data.endTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
        && (!('departureCheckTime' in data) || (data.departureCheckTime is string
          && (data.departureCheckTime == '' || data.departureCheckTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))))
        && (!('note' in data) || validText(data.note,0,500))
        && (data.leaderUid == null || validText(data.leaderUid,1,128))
        && data.memberUids is list && data.memberUids.size() <= 99
        && data.memberUids.toSet().size() == data.memberUids.size()
        && (data.leaderUid == null || data.leaderUid in data.memberUids)
        && (data.requiredMembers == null
          || (data.requiredMembers is int && data.requiredMembers >= 1 && data.requiredMembers <= 99))
        && data.status in ['draft','confirmed'] && validText(data.createdBy,1,128)
        && (!('createdByName' in data) || validText(data.createdByName,1,80))
        && validText(data.updatedByUid,1,128) && validText(data.updatedByName,1,80)
        && (data.leaderUid == null
          || (isOperationalStatus(get(rolePath(data.leaderUid)).data.accountStatus)
            && get(rolePath(data.leaderUid)).data.branchId == data.branchId))
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function shiftPath(shiftId) {
      return /databases/$(database)/documents/shiftGroups/$(shiftId);
    }
    function isValidShiftMemberProfile(data, shiftId, workerId) {
      return data.keys().hasAll(['workerId','name','employeeNumber','nearestStation','branchId','updatedAt'])
        && data.keys().hasOnly(['workerId','name','employeeNumber','nearestStation','branchId','updatedAt'])
        && data.workerId == workerId
        && validText(data.name,1,80)
        && data.employeeNumber is string && data.employeeNumber.matches('^[0-9]{6}$')
        && validText(data.nearestStation,0,80)
        && validText(data.branchId,1,40)
        && data.updatedAt is timestamp
        && data.name == get(/databases/$(database)/documents/users/$(workerId)).data.name
        && data.employeeNumber == get(/databases/$(database)/documents/users/$(workerId)).data.employeeNumber
        && data.nearestStation == get(/databases/$(database)/documents/users/$(workerId)).data.nearestStation
        && data.branchId == get(/databases/$(database)/documents/users/$(workerId)).data.branchId
        && data.branchId == getAfter(shiftPath(shiftId)).data.branchId
        && workerId in getAfter(shiftPath(shiftId)).data.memberUids;
    }
    function isValidProgress(data, shiftId, workerId) {
      return data.keys().hasAll(['shiftGroupId','workerId','branchId','date','shiftType',
          'createdAt','updatedAt','updatedByUid','updatedByName','updatedByType'])
        && data.keys().hasOnly(['shiftGroupId','workerId','branchId','date','shiftType',
          'departureAcknowledgedAt','departureTime','departedAt','arrivedAt','startedAt','finishedAt',
          'createdAt','updatedAt','updatedByUid','updatedByName','updatedByType'])
        && data.shiftGroupId == shiftId && data.workerId == workerId
        && validText(data.shiftGroupId,1,128) && validText(data.workerId,1,128)
        && validText(data.branchId,1,40)
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shiftType in ['day','night']
        && (!('departureAcknowledgedAt' in data) || data.departureAcknowledgedAt is timestamp)
        && (!('departureTime' in data) || (data.departureTime is string
          && data.departureTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('departedAt' in data) || data.departedAt is timestamp)
        && (!('arrivedAt' in data) || data.arrivedAt is timestamp)
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('finishedAt' in data) || data.finishedAt is timestamp)
        && progressSequenceValid(data)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validText(data.updatedByUid,1,128) && validText(data.updatedByName,1,80)
        && data.updatedByType in ['self','staff'];
    }
    function progressMatchesShift(data) {
      return get(shiftPath(data.shiftGroupId)).data.status == 'confirmed'
        && data.branchId == get(shiftPath(data.shiftGroupId)).data.branchId
        && data.date == get(shiftPath(data.shiftGroupId)).data.date
        && data.shiftType == get(shiftPath(data.shiftGroupId)).data.shiftType
        && data.workerId in get(shiftPath(data.shiftGroupId)).data.memberUids;
    }
    function progressSequenceValid(data) {
      return (!('departedAt' in data) || 'departureAcknowledgedAt' in data)
        && (!('startedAt' in data) || 'departedAt' in data)
        && (!('finishedAt' in data) || 'startedAt' in data);
    }
    function departureTimePresentForNewAcknowledgement() {
      return !('departureAcknowledgedAt' in request.resource.data)
        || ('departureTime' in request.resource.data);
    }
    function departureTimePresentForUpdatedAcknowledgement() {
      return ('departureAcknowledgedAt' in resource.data)
        || !('departureAcknowledgedAt' in request.resource.data)
        || ('departureTime' in request.resource.data);
    }
    function selfProgressTimestampsValid() {
      return (!('departureAcknowledgedAt' in request.resource.data)
          || request.resource.data.departureAcknowledgedAt == request.time
          || (('departureAcknowledgedAt' in resource.data)
            && request.resource.data.departureAcknowledgedAt == resource.data.departureAcknowledgedAt))
        && (!('departureTime' in resource.data)
          || request.resource.data.departureTime == resource.data.departureTime)
        && (!('departedAt' in request.resource.data)
          || request.resource.data.departedAt == request.time
          || (('departedAt' in resource.data) && request.resource.data.departedAt == resource.data.departedAt))
        && (!('arrivedAt' in request.resource.data)
          || request.resource.data.arrivedAt == request.time
          || (('arrivedAt' in resource.data) && request.resource.data.arrivedAt == resource.data.arrivedAt))
        && (!('startedAt' in request.resource.data)
          || request.resource.data.startedAt == request.time
          || (('startedAt' in resource.data) && request.resource.data.startedAt == resource.data.startedAt))
        && (!('finishedAt' in request.resource.data)
          || request.resource.data.finishedAt == request.time
          || (('finishedAt' in resource.data) && request.resource.data.finishedAt == resource.data.finishedAt));
    }
    function selfInitialProgressValid() {
      return 'departureAcknowledgedAt' in request.resource.data
        && !('departedAt' in request.resource.data)
        && !('startedAt' in request.resource.data)
        && !('finishedAt' in request.resource.data);
    }
    function selfProgressTransitionValid() {
      return (
          !('departedAt' in resource.data)
          && 'departureAcknowledgedAt' in resource.data
          && 'departedAt' in request.resource.data
          && !('startedAt' in request.resource.data)
          && !('finishedAt' in request.resource.data)
        ) || (
          'departedAt' in resource.data
          && !('startedAt' in resource.data)
          && 'startedAt' in request.resource.data
          && !('finishedAt' in request.resource.data)
        ) || (
          'startedAt' in resource.data
          && !('finishedAt' in resource.data)
          && 'finishedAt' in request.resource.data
        );
    }
    function availabilityPath(date, workerId) {
      return /databases/$(database)/documents/availability/$(date + '_' + workerId);
    }
    function attendanceMatchesAvailability(data, date, shiftType, workerId) {
      return exists(availabilityPath(date, workerId))
        && get(availabilityPath(date, workerId)).data.uid == workerId
        && get(availabilityPath(date, workerId)).data.date == date
        && get(availabilityPath(date, workerId)).data.branchId == data.branchId
        && ((shiftType == 'day'
            && get(availabilityPath(date, workerId)).data.day == true
            && (!('dayEntered' in get(availabilityPath(date, workerId)).data)
              || get(availabilityPath(date, workerId)).data.dayEntered == true))
          || (shiftType == 'night'
            && get(availabilityPath(date, workerId)).data.night == true
            && (!('nightEntered' in get(availabilityPath(date, workerId)).data)
              || get(availabilityPath(date, workerId)).data.nightEntered == true)))
        && get(availabilityPath(date, workerId)).data.unavailable == false
        && get(availabilityPath(date, workerId)).data.undecided == false;
    }
    function isValidAttendanceProgress(data, date, shiftType, workerId) {
      return data.keys().hasAll(['workerId','branchId','date','shiftType','createdAt','updatedAt',
          'updatedByUid','updatedByName','updatedByType'])
        && data.keys().hasOnly(['workerId','branchId','date','shiftType','departureAcknowledgedAt',
          'departureTime','departedAt','startedAt','finishedAt','finishedTime','createdAt','updatedAt',
          'updatedByUid','updatedByName','updatedByType'])
        && data.workerId == workerId && data.date == date && data.shiftType == shiftType
        && validText(data.workerId,1,128) && validBranchId(data.branchId)
        && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.shiftType in ['day','night']
        && (!('departureAcknowledgedAt' in data) || data.departureAcknowledgedAt is timestamp)
        && (!('departureTime' in data) || (data.departureTime is string
          && data.departureTime.matches('^([01][0-9]|2[0-4]):(00|05|10|15|20|25|30|35|40|45|50|55)$')))
        && (!('departedAt' in data) || data.departedAt is timestamp)
        && (!('startedAt' in data) || data.startedAt is timestamp)
        && (!('finishedAt' in data) || data.finishedAt is timestamp)
        && (!('finishedTime' in data) || (data.finishedTime is string
          && data.finishedTime.matches('^([01][0-9]|2[0-4]):(00|05|10|15|20|25|30|35|40|45|50|55)$')))
        && (!('finishedAt' in data) || 'finishedTime' in data)
        && (!('finishedTime' in data) || 'finishedAt' in data)
        && progressSequenceValid(data)
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && validText(data.updatedByUid,1,128) && validText(data.updatedByName,1,80)
        && data.updatedByType in ['self','staff']
        && attendanceMatchesAvailability(data,date,shiftType,workerId);
    }

    match /employeeNumbers/{number} {
      allow create: if request.resource.data.keys().hasOnly(['uid','accountStatus','requestedBranchId','branchId'])
        && number.matches('^[0-9]{6}$')
        && !exists(/databases/$(database)/documents/employeeNumbers/$(number))
        && (
          (isOwner(request.resource.data.uid)
            && request.auth.token.email == internalEmail(number)
            && request.resource.data.accountStatus == 'pending'
            && validBranchId(request.resource.data.requestedBranchId)
            && !('branchId' in request.resource.data))
          || (isOffice()
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.inputMode == 'managed'
            && getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.employeeNumber == number
            && isSameBranch(getAfter(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.branchId)
            && getAfter(rolePath(request.resource.data.uid)).data.role == 'guard')
        );
      allow update: if (isAdmin()
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.requestedBranchId == resource.data.requestedBranchId
          && request.resource.data.accountStatus in ['approved','rejected']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accountStatus','branchId'])
          && (request.resource.data.accountStatus == 'rejected'
            || validBranchId(request.resource.data.branchId)))
        || (resource.data.accountStatus == 'rejected'
          && (!exists(rolePath(resource.data.uid))
            || get(rolePath(resource.data.uid)).data.accountStatus == 'rejected')
