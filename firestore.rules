rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // users/{uid}: PII profile plus immutable role/branchId/accountStatus.
    // availability/{date_uid}: owner UID, branchId, date, choices, note, timestamps.
    // employeeNumbers and _loginAttempts: Admin SDK only.
    function isAuthenticated() { return request.auth != null; }
    function isVerified() { return isAuthenticated() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    function role() { return request.auth.token.role; }
    function branchId() { return request.auth.token.branchId; }
    function isGuard() { return isVerified() && role() == 'guard'; }
    function isStaff() { return isVerified() && role() == 'staff'; }
    function isAdmin() { return isVerified() && role() == 'admin'; }
    function validText(value, min, max) { return value is string && value.size() >= min && value.size() <= max; }
    function validEmail(value) {
      return validText(value, 3, 254) && value.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$');
    }
    function isValidUser(data) {
      return data.keys().hasAll(['employeeNumber','name','email','postalCode','prefecture','city',
        'addressLine','building','nearestStation','branchId','role','accountStatus','createdAt','updatedAt'])
        && data.keys().hasOnly(['employeeNumber','name','email','postalCode','prefecture','city',
        'addressLine','building','nearestStation','branchId','role','accountStatus','createdAt','updatedAt'])
        && data.employeeNumber is string && data.employeeNumber.matches('^[0-9]{6}$')
        && validText(data.name, 1, 80) && validEmail(data.email)
        && data.postalCode is string && data.postalCode.matches('^[0-9]{7}$')
        && validText(data.prefecture, 1, 20) && validText(data.city, 1, 80)
        && validText(data.addressLine, 1, 160) && validText(data.building, 0, 160)
        && validText(data.nearestStation, 0, 80)
        && validText(data.branchId, 1, 40) && data.role in ['guard','staff','admin']
        && data.accountStatus in ['active','suspended','disabled']
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    function validChoice(data) {
      return (!data.unavailable || (!data.day && !data.night && !data.undecided))
        && (!data.undecided || (!data.day && !data.night && !data.unavailable));
    }
    function isValidAvailability(data, id) {
      return data.keys().hasAll(['uid','branchId','date','day','night','unavailable','undecided','note','createdAt','updatedAt'])
        && data.keys().hasOnly(['uid','branchId','date','day','night','unavailable','undecided','note','createdAt','updatedAt'])
        && data.uid is string && data.uid == request.auth.uid
        && data.branchId is string && data.branchId == branchId()
        && data.date is string && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && id == data.date + '_' + data.uid
        && data.day is bool && data.night is bool && data.unavailable is bool && data.undecided is bool
        && validChoice(data) && validText(data.note, 0, 500)
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow read: if isVerified() && (
        isOwner(uid) || isAdmin() || (isStaff() && resource.data.branchId == branchId())
      );
      allow create: if false;
      allow update: if isVerified() && isOwner(uid) && isValidUser(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['employeeNumber','email','role','branchId','accountStatus','createdAt'])
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /availability/{id} {
      allow read: if isVerified() && (
        resource.data.uid == request.auth.uid || isAdmin()
        || (isStaff() && resource.data.branchId == branchId())
      );
      allow create: if isGuard() && isValidAvailability(request.resource.data, id)
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isGuard() && resource.data.uid == request.auth.uid
        && isValidAvailability(request.resource.data, id)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /employeeNumbers/{id} { allow read, write: if false; }
    match /_loginAttempts/{id} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
